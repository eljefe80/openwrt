config wbctl 'global'
	option enabled '1'
	option host '192.168.1.2'
	option port '1883'
	option user ''
	option pass ''
	option base_topic 'wattbox'
	option disco_prefix 'homeassistant'
	option serial '/dev/ttyS1'
	option device_name 'WattBox'
	option uid 'wattbox'
	option poll '10'
	option num_outlets '5'
	option volt_scale '0.1'
	option curr_scale '0.1'
	# persisted last-known outlet state (jffs2 overlay; survives reboot/reflash)
	option state_file '/etc/wbctl.state'
	# ms stagger between per-outlet restores at boot (0 = simultaneous)
	option power_on_delay '0'
	# seconds an outlet stays off during a Reset (power-cycle) button press
	option reset_delay '5'

# Per outlet: option power_on 'last' | 'on' | 'off'
#   last = restore the state it was in before power loss (default)
#   on   = always power on at boot
#   off  = always stay off at boot
config outlet
	option name 'Outlet 1'
	option power_on 'last'
config outlet
	option name 'Outlet 2'
	option power_on 'last'
config outlet
	option name 'Outlet 3'
	option power_on 'last'
config outlet
	option name 'Outlet 4'
	option power_on 'last'
config outlet
	option name 'Outlet 5'
	option power_on 'last'

# 3 bi-color LEDs, each off/green/red/amber (HA select). The front-panel Power
# LED is a hardwired power indicator, not on the $L bus, so it is not listed.
config led 'internet'
	option name 'Internet LED'
config led 'system'
	option name 'System LED'
config led 'auto_reboot'
	option name 'Auto-Reboot LED'
