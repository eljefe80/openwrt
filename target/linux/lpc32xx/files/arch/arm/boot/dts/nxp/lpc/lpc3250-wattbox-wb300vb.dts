// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * SnapAV WattBox WB-300VB-IP-5 (and sibling WB-300/700 IP-series units)
 *
 * Reverse-engineered from firmware WB10.B929 (2022-12-06): a U-Boot legacy
 * uImage wrapping a Linux 2.6.34 zImage, `console=/dev/null mem=32M` boot
 * args, and a CramFS rootfs.
 *
 * 2026-08-18 UPDATE: a live root shell was obtained on a real unit
 * (10.203.254.48) over telnet, and the hardware bring-up checklist was run
 * against the running stock firmware (read-only, no flash writes). Values
 * previously guessed are now measured; the sources are marked below as:
 *   MEASURED   -- read directly from /proc, /sys, /proc/iomem on the device.
 *   CONFIRMED  -- proven from the firmware/protocol reverse-engineering.
 *   UNVERIFIED -- still a best-effort guess; do not treat as flash-safe.
 * See ~/share/projects/wb-300VB-IP-5/bringup-results-2026-08-18.md.
 *
 * The single biggest correction: this board has NO NAND. It boots from a
 * memory-mapped parallel NOR on the LPC32xx EMC (external memory
 * controller), and carries a second, SPI NOR chip for its writable log
 * store. The old &slc NAND node was wrong and has been removed.
 */

/dts-v1/;
#include "lpc32xx.dtsi"

/ {
	model = "SnapAV WattBox WB-300VB-IP-5";
	compatible = "snapav,wattbox-wb300vb", "nxp,lpc3250";

	/*
	 * MEASURED: /proc/tty/driver/serial + /proc/iomem show exactly three
	 * wired UARTs on the stock kernel, and they enumerate in this order:
	 *   ttyS0 = uart5 @ 0x40090000 (idle -- the physical console header)
	 *   ttyS1 = uart3 @ 0x40080000 (busy both ways -- the outlet-PIC link)
	 *   ttyS2 = uart4 @ 0x40088000 (TX only -- RS-232 passthrough)
	 * Pin the same numbering here so vendor-userspace assumptions about
	 * /dev/ttyS1 (the PIC link, see below) still hold under mainline.
	 */
	aliases {
		serial0 = &uart5;
		serial1 = &uart3;
		serial2 = &uart4;
	};

	/*
	 * MEASURED: stock boots with `console=/dev/null`, so nothing was ever
	 * emitted on the header. uart5 (ttyS0) is idle (tx:0 rx:0) -- the most
	 * likely physical console pinout. Baud is UNVERIFIED; 115200 is the
	 * LPC32xx convention. If nothing prints on first boot, this line and
	 * the uart5 pinout are the first things to re-check.
	 */
	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* MEASURED: /proc/meminfo + /proc/iomem "System RAM 0x80000000-0x81ffffff",
	 * boot arg `mem=32M`. 32 MB DDR at 0x80000000. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x2000000>;
	};

	/*
	 * MEASURED that they exist, UNVERIFIED which GPIO lines:
	 * /sys/class/leds shows three GPIO-backed LEDs (led0/led1/led2, timer
	 * trigger, max_brightness 255), and /proc/interrupts shows a
	 * "gpio_btn1_irq" (IRQ 89) -- a physical button. The exact GPIO lines
	 * could NOT be read: debugfs-gpio is compiled out of the stock kernel
	 * and busybox has no way to dump the pinmux. The outlet relays
	 * themselves are NOT SoC GPIOs -- they're switched by a separate PIC
	 * over /dev/ttyS1 ("T%02dY\r" / "T%02dN\r", see libtasks.so). Add real
	 * gpio-leds / gpio-keys nodes here once the three LED lines and the
	 * button line are traced (serial console + /sys, or a multimeter)
	 * against a running unit. Left out rather than driving a wrong pin.
	 */
};

/*
 * MEASURED: the three wired UARTs are all the standard (nxp,lpc3220-uart,
 * "16550A") type, at the addresses above. uart6 and the three hsuarts are
 * not wired on this board and stay disabled (default in lpc32xx.dtsi).
 *
 * CONFIRMED (wattbox_decompiled.c): the outlet-control PIC is on /dev/ttyS1
 * at 2400 baud, raw/CS8 -- which the alias above maps to uart3 @ 0x40080000,
 * matching the one UART that showed heavy bidirectional traffic (tx:2565
 * rx:5851) on the live unit. Do NOT send test bytes here casually: writing
 * "T01Y\r" toggles a real mains relay.
 */
&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&uart5 {
	status = "okay";
};

/*
 * CONFIRMED it's a LAN device (the whole raw-Ethernet discovery/config
 * protocol and the HTTP UI depend on it). MEASURED on the live unit:
 * lpc-net.0 @ 0x31060000, eth0 IRQ 29, MAC d4:6a:91:03:5e:f2, using the
 * mainline lpc_eth driver. RMII + IRAM descriptors is the standard LPC32x0
 * wiring; phy-mode is UNVERIFIED (could be MII) but very unlikely to be
 * anything else given the SoC has only the one MAC.
 */
&mac {
	/* phy-mode: stock RMII gave 100% RX/TX frame corruption (link up, but
	 * rx_packets=0 / rx_errors climbing, and giada never saw our TX) --
	 * classic MII-vs-RMII wiring mismatch. Trying MII. */
	phy-mode = "mii";
	use-iram;
	/*
	 * No MAC is set here on purpose. The LPC32xx ENET has no MAC in HW/OTP
	 * (POR = all zeros) and this NOR stores none, so lpc_eth would fall back
	 * to a random MAC each boot. A stable, per-unit, locally-administered MAC
	 * is derived from the SoC unique ID in userspace (base-files
	 * etc/board.d/02_network) -- keeping this image generic rather than
	 * baking in one unit's address.
	 */
	status = "okay";
};

/*
 * MEASURED -- the boot flash. This is a parallel NOR wired to EMC static
 * chip-select 0, memory-mapped at 0xE0000000 (/proc/iomem: "physmap-flash.0
 * e0000000-e07fffff"), 8 MB, six fixed partitions. It holds the bootloader,
 * kernel and CramFS root (`root=/dev/mtdblock2`). This node is load-bearing:
 * get it wrong and the unit won't boot from flash.
 *
 * How pl172 (the arm,pl175 EMC driver) uses this node: for each child it
 * REQUIRES `mpmc,cs` and `mpmc,memory-width`, reprograms only the CS width
 * register from memory-width, leaves the (safe, slow) reset timings in place
 * unless mpmc,*-delay timing props are given, then populates the child as an
 * MTD map device via the "cfi-flash" (physmap-core) driver.
 *
 * UNVERIFIED: `mpmc,memory-width`/`bank-width` = 16-bit. An 8 MB single-chip
 * NOR on the LPC32xx 16-bit EMC bus is almost certainly x16, but this was
 * not read from the device (no od/mtdinfo applet in the stock busybox). If
 * the chip does not probe on first boot, try memory-width = <8> / bank-width
 * = <1>. Because the wrong width only affects Linux's own access (U-Boot
 * still loads the kernel with its own EMC setup), and validation is done via
 * a TFTP initramfs with root NOT on this flash, a wrong guess here is
 * detected safely -- it never bricks the unit. Confirm the width and the
 * chip's real CFI/JEDEC id from /proc/mtd + mtdinfo on that first boot.
 *
 * Partition offsets are contiguous-from-zero, derived from the erase-block
 * sizes in /proc/mtd (which lists partitions in flash order); sizes are
 * MEASURED verbatim. They sum to exactly 0x800000 = 8 MB.
 */
/*
 * EMC CS0 timing: keep the controller enabled and configure CS0 from the
 * chip width so writes/erases are correctly timed. pl172 only *configures*
 * this child (via mpmc,cs + mpmc,memory-width); it does NOT turn it into an
 * MTD. The actual NOR MTD is the TOP-LEVEL cfi-flash node below.
 *
 * Why not the flash node here: pl172 does of_platform_populate(child), which
 * instantiates the child's *children* (the partitions subnode), NOT the flash
 * node itself -- so a `cfi-flash` node placed under &emc never becomes a
 * platform device and physmap never binds (observed: only an
 * "e0000000.flash:partitions" device appeared, no /dev/mtd*, no CFI probe).
 * A root-level node with the absolute physical reg IS populated by the
 * platform bus, so physmap-core binds and runs the CFI probe.
 */
&emc {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <1>;

	nor-cs@0 {
		reg = <0 0x00800000>;		/* EMC CS0 -> 0xE0000000, 8 MB */
		mpmc,cs = <0>;
		mpmc,memory-width = <16>;	/* x16 8MB NOR on the 16-bit EMC */
		/*
		 * PB (byte-lane state, EMCStaticConfig0 bit7). Vendor U-Boot sets
		 * this (0x81); without it pl172 programs 0x01 and the byte-lane/WE#
		 * strobes don't drive on writes -> ALL parallel-NOR erase/program
		 * from Linux fails ("MTD do_erase_oneblock(): software timeout").
		 * REQUIRED for the jffs2 overlay (rootfs_data) to be writable.
		 * See gotcha_wattbox_emc_pb_bit_nor_writes.
		 */
		mpmc,byte-lane-low;
	};
};

/* Memory-mapped parallel NOR (mtd0-5 on stock). Absolute physical address so
 * the physmap-core "cfi-flash" driver binds directly. bank-width 2 = x16. */
/ {
	nor: flash@e0000000 {
		compatible = "cfi-flash";
		reg = <0xe0000000 0x00800000>;	/* 8 MB @ 0xE0000000 */
		bank-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootcode";
				reg = <0x00000000 0x00020000>;	/* 128 KB */
				read-only;
			};
			/*
			 * No-initramfs install layout. The self-decompressing
			 * kernel (zImage+appended-DTB, ~2.70 MB) needs > the old
			 * 1.625 MB, so "kernel" is grown to 3 MB. "rootfs" is
			 * sized to EXACTLY the block-aligned squashfs (0x1a0000)
			 * so mtdsplit finds no trailing space and does NOT carve
			 * a rootfs_data here -- the writable overlay is the 8 MB
			 * SPI NOR (mtd6 "rootfs_data") instead. U-Boot bootcmd
			 * (cp.b 0xE0020000 -> 0x80008000, then go) is unchanged;
			 * it copies from 0x20000 and the zImage self-extracts.
			 * The gap 0x4c0000..0x7d0000 is intentionally unused so
			 * nvram/u-boot-env keep their fixed top-of-flash offsets.
			 */
			partition@20000 {
				label = "kernel";
				reg = <0x00020000 0x00300000>;	/* 3 MB */
			};
			partition@320000 {
				label = "rootfs";
				reg = <0x00320000 0x001a0000>;	/* 1.625 MB = block-aligned squashfs */
			};
			partition@7d0000 {
				label = "nvram";
				reg = <0x007d0000 0x00020000>;	/* 128 KB */
				read-only;
			};
			partition@7f0000 {
				label = "u-boot-env";
				reg = <0x007f0000 0x00010000>;	/* 64 KB */
			};
		};
	};
};

/*
 * Second flash: 8 MB SPI NOR (Macronix MX25L64, JEDEC c2 20 17) on the
 * LPC32xx SSP0/PL022 controller (@0x20084000, IRQ 20). Stock mounts it whole
 * as jffs2 at /mnt/log. We use it as the OpenWrt overlay (rootfs_data) so the
 * parallel NOR stays a read-only boot flash.
 *
 * CS = GPIO_05 (bank 3, pin 5) -- CONFIRMED: driving SSP0 with CS=GPIO_05
 * (P2_GPIO05_SSEL0 mux=GPIO, P3_OUTP bit30) returned JEDEC c2 20 17 from the
 * MX25L64. Matches the stock phy3250 reference DTS (cs-gpios = <&gpio 3 5 0>).
 */
&ssp0 {
	num-cs = <1>;
	/*
	 * GPIO_05 (bank 3, pin 5) = SPI NOR chip select, ACTIVE LOW.
	 * The modern gpiod SPI core drives the CS pin per this flag:
	 * with ACTIVE_HIGH (0) it drives CS high-to-select, which leaves the
	 * active-low MX25L64 DEselected -> spi-nor reads JEDEC 0xff (observed).
	 * Proven active-low: driving GPIO_05 LOW by hand returns JEDEC c2 20 17.
	 */
	cs-gpios = <&gpio 3 5 1>;	/* 1 = GPIO_ACTIVE_LOW */
	status = "okay";

	spi_nor: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <20000000>;	/* conservative; chip does 50MHz+ */

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* whole chip = OpenWrt overlay; formatted jffs2 on first boot */
			partition@0 {
				label = "rootfs_data";
				reg = <0x00000000 0x00800000>;	/* 8 MB */
			};
		};
	};
};
