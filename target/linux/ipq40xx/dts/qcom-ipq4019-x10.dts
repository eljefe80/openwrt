// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * ASRock X10 IoT router (IPQ4019, 256 MiB RAM, 32 MiB SPI-NOR)
 *
 * Derived from the stock 1.70 firmware, which boots an unmodified QCA
 * AP-DK04.1 device tree and drives all board-specific peripherals from
 * userspace via sysfs GPIO. Pin assignments below come from those stock
 * scripts; Zigbee, IR, Ethernet, Wi-Fi calibration and MACs are verified
 * on hardware, LED colors are not.
 *
 * Peripherals:
 *  - TI CC2630 Zigbee NCP (Z-Stack ZNP) on blsp1_uart2 (ttyMSM1), 115200 8N1,
 *    no flow control. Reset is active-low on gpio18 (gpio32 on SR2 boards),
 *    ROM serial-bootloader backdoor (CC2630 DIO6, active-high) on gpio49.
 *  - Sonix SN8 IR blaster MCU and LoRa module on a bit-banged I2C bus;
 *    IR MCU reset on gpio46.
 */

#include "qcom-ipq4019.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/soc/qcom,tcsr.h>

/ {
	model = "ASRock X10";
	compatible = "asrock,x10";

	aliases {
		serial0 = &blsp1_uart1;
		serial1 = &blsp1_uart2;
		led-boot = &led_status_blue;
		led-failsafe = &led_status_red;
		led-running = &led_status_blue;
		led-upgrade = &led_status_amber;
		label-mac-device = &gmac;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};

	soc {
		tcsr@1949000 {
			compatible = "qcom,tcsr";
			reg = <0x1949000 0x100>;
			qcom,wifi_glb_cfg = <TCSR_WIFI_GLB_CFG>;
		};

		tcsr@194b000 {
			/* select hostmode */
			compatible = "qcom,tcsr";
			reg = <0x194b000 0x100>;
			qcom,usb-hsphy-mode-select = <TCSR_USB_HSPHY_HOST_MODE>;
			status = "okay";
		};

		ess_tcsr@1953000 {
			compatible = "qcom,tcsr";
			reg = <0x1953000 0x1000>;
			qcom,ess-interface-select = <TCSR_ESS_PSGMII>;
		};

		tcsr@1957000 {
			compatible = "qcom,tcsr";
			reg = <0x1957000 0x100>;
			qcom,wifi_noc_memtype_m0_m2 = <TCSR_WIFI_NOC_MEMTYPE_M0_M2>;
		};
	};

	keys {
		compatible = "gpio-keys";

		wps {
			label = "wps";
			gpios = <&tlmm 63 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		reset {
			label = "reset";
			gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* stock firmware always drives gpio54 and gpio36 together */
		led_status_red: status-red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			function-enumerator = <1>;
			gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
		};

		status-red-2 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			function-enumerator = <2>;
			gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: status-blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 68 GPIO_ACTIVE_HIGH>;
		};

		led_status_amber: status-amber {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&tlmm 53 GPIO_ACTIVE_HIGH>;
		};

		/* colors of the LoRa and Zigbee indicators are not known yet */
		lora {
			label = "x10:lora";
			gpios = <&tlmm 65 GPIO_ACTIVE_HIGH>;
		};

		zigbee {
			label = "x10:zigbee";
			gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;
		};
	};

	i2c_ir: i2c-gpio {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 59 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 58 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,scl-output-only;
		i2c-gpio,delay-us = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&watchdog {
	status = "okay";
};

&prng {
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&blsp_dma {
	status = "okay";
};

&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";
	cs-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <24000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "SBL1";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "MIBIB";
				reg = <0x40000 0x20000>;
				read-only;
			};

			partition@60000 {
				label = "QSEE";
				reg = <0x60000 0x60000>;
				read-only;
			};

			partition@c0000 {
				label = "CDT";
				reg = <0xc0000 0x10000>;
				read-only;
			};

			partition@d0000 {
				label = "DDRPARAMS";
				reg = <0xd0000 0x10000>;
				read-only;
			};

			partition@e0000 {
				label = "APPSBLENV";
				reg = <0xe0000 0x10000>;
			};

			partition@f0000 {
				label = "APPSBL";
				reg = <0xf0000 0x80000>;
				read-only;
			};

			partition@170000 {
				label = "ART";
				reg = <0x170000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_gmac0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					macaddr_gmac1: macaddr@6 {
						reg = <0x6 0x6>;
					};

					precal_art_1000: precal@1000 {
						reg = <0x1000 0x2f20>;
					};

					precal_art_5000: precal@5000 {
						reg = <0x5000 0x2f20>;
					};
				};
			};

			/*
			 * Exactly the HLOS + rootfs range the stock flash script
			 * erases (0x180000 + 0x400000, 0x580000 + 0x1900000).
			 */
			partition@180000 {
				compatible = "denx,fit";
				label = "firmware";
				reg = <0x180000 0x1d00000>;
			};

			/*
			 * Stock jffs2 overlay and the "boardcfg" partition holding
			 * the factory MAC addresses and serial number. The exact
			 * split is unknown until /proc/mtd is read from a stock
			 * unit, so the whole tail is kept read-only.
			 */
			partition@1e80000 {
				label = "stock_data";
				reg = <0x1e80000 0x180000>;
				read-only;
			};
		};
	};
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* TI CC2630 Zigbee NCP */
&blsp1_uart2 {
	pinctrl-0 = <&serial_1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&tlmm {
	serial_0_pins: serial0-pinmux {
		mux {
			pins = "gpio16", "gpio17";
			function = "blsp_uart0";
			bias-disable;
		};
	};

	serial_1_pins: serial1-pinmux {
		mux {
			pins = "gpio8", "gpio9";
			function = "blsp_uart1";
			bias-disable;
		};
	};

	spi_0_pins: spi-0-pinmux {
		pin {
			function = "blsp_spi0";
			pins = "gpio13", "gpio14", "gpio15";
			drive-strength = <12>;
			bias-disable;
		};

		pin-cs {
			function = "gpio";
			pins = "gpio12";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};
};

&usb2_hs_phy {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&usb3_hs_phy {
	status = "okay";
};

&usb3_ss_phy {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&mdio {
	status = "okay";
};

&gmac {
	status = "okay";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac0 0>;
};

&switch {
	status = "okay";
};

/* stock VLAN layout: WAN on switch port 1, LAN on ports 2-5 */
&swport1 {
	status = "okay";

	label = "wan";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac1>;
};

&swport2 {
	status = "okay";

	label = "lan1";
};

&swport3 {
	status = "okay";

	label = "lan2";
};

&swport4 {
	status = "okay";

	label = "lan3";
};

&swport5 {
	status = "okay";

	label = "lan4";
};

&wifi0 {
	status = "okay";
	nvmem-cell-names = "pre-calibration";
	nvmem-cells = <&precal_art_1000>;
	qcom,ath10k-calibration-variant = "ASRock-X10";
};

&wifi1 {
	status = "okay";
	nvmem-cell-names = "pre-calibration";
	nvmem-cells = <&precal_art_5000>;
	qcom,ath10k-calibration-variant = "ASRock-X10";
};
