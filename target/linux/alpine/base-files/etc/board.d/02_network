. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

board=$(board_name)

case "$board" in
checkpoint,l72w)
	#
	# 19 physical Ethernet ports: 16 LAN, 1 WAN, 2 DMZ (1 copper,
	# 1 SFP). The 16 LAN ports sit behind a Marvell Prestera
	# 98DX3234 fabric reached over an SMI tunnel on eth0's MDIO bus;
	# it is driven by drivers/net/ethernet/marvell/checkpoint98dx3234
	# and described by the `switch` node in alpine-l72w.dts, so they
	# appear as DSA ports lan1..lan16. See
	# l72w-openwrt/docs/98dx3234-l72w-specs.md.
	#
	# eth0 and eth2 are the two fabric-facing MACs. They must run
	# 1G SGMII with link management off -- NOT 2.5G, which is what
	# the bootloader's scratch register asks for and what an earlier
	# revision of this comment claimed. Getting that wrong is silent:
	# the port receives and refuses to transmit, with no error
	# anywhere. See spec section 10.1.
	#
	# eth1 is CONFIRMED = DMZ copper (the only MAC with a real
	# external PHY; matches the cabled port showing Link Up and
	# U-Boot's own "Using al_eth1 device" for TFTP). eth3 is one of
	# {WAN, DMZ-SFP}, not yet pinned down.
	#
	# Kernel netdev names are PCI-probe-order, confirmed live
	# 2026-09-12: eth0=PCI 00:00.0 (DTS &eth0/port0), eth1=PCI
	# 00:01.0 (DTS &eth1, legacy port1 -- external PHY), eth2=PCI
	# 00:02.0 (DTS &eth2/port2), eth3=PCI 00:03.0 (DTS &eth3, the 4th
	# MAC not in the upstream reference). NOT guaranteed stable if
	# driver probe order ever changes -- re-verify by MAC address
	# (ip link) after any kernel/driver bump.
	#
	# eth1 (external-PHY port) previously hard-hung the whole box
	# (silent, no panic/oops) the instant it was brought up -- root
	# caused to a genuine rtnl_lock self-deadlock in al_eth_open()
	# (mdiobus_register()/phy_device_register() called from ndo_open,
	# which itself runs under rtnl_lock). Fixed in al_eth.c by
	# registering the mdio bus once at al_eth_probe() time instead
	# (lock-free) and tearing it down at al_eth_remove(); confirmed
	# live 2026-09-12 -- up/down cycled repeatedly with a real PHY
	# link (1Gbps/Full) and no hang. See project_l72w_openwrt.md.
	#
	# Deliberately left unconfigured/unbridged (protocol "none" on
	# each, since "lan"/"wan" naming is what triggers a default
	# protocol) -- role assignment (LAN/WAN/VLANs) is left to UCI/LuCI
	# per Jeff's own call, not a hardcoded board default.
	#
	ucidef_set_interface "port0" device "eth0" protocol "none"
	ucidef_set_interface "port1" device "eth1" protocol "none"
	ucidef_set_interface "port2" device "eth2" protocol "none"
	ucidef_set_interface "port3" device "eth3" protocol "none"
	#
	# The DSA user ports, declared so they show up in UCI/LuCI but
	# left unbridged. Two reasons, either sufficient: role
	# assignment here is a UCI decision rather than a board default,
	# and the fabric already floods between all of these ports in
	# hardware with no STP (measured, spec section 12.1) -- a bridge
	# on top would be a loop.
	#
	# WARNING until the driver isolates ports: never connect two of
	# these ports to the same L2 network. The switch forwards between
	# them on its own and will storm that network.
	#
	ucidef_set_interface "lan1" device "lan1" protocol "none"
	ucidef_set_interface "lan2" device "lan2" protocol "none"
	ucidef_set_interface "lan3" device "lan3" protocol "none"
	ucidef_set_interface "lan4" device "lan4" protocol "none"
	ucidef_set_interface "lan5" device "lan5" protocol "none"
	ucidef_set_interface "lan6" device "lan6" protocol "none"
	ucidef_set_interface "lan7" device "lan7" protocol "none"
	ucidef_set_interface "lan8" device "lan8" protocol "none"
	ucidef_set_interface "lan9" device "lan9" protocol "none"
	ucidef_set_interface "lan10" device "lan10" protocol "none"
	ucidef_set_interface "lan11" device "lan11" protocol "none"
	ucidef_set_interface "lan12" device "lan12" protocol "none"
	ucidef_set_interface "lan13" device "lan13" protocol "none"
	ucidef_set_interface "lan14" device "lan14" protocol "none"
	ucidef_set_interface "lan15" device "lan15" protocol "none"
	ucidef_set_interface "lan16" device "lan16" protocol "none"
	;;
mikrotik,rb1100ahx4)
	#
	# DSA switches:
	# wan  = lan1
	# lan  = lan2-lan13
	#
	ucidef_set_interfaces_lan_wan \
		"lan2 lan3 lan4 lan5 lan6 lan7 lan8 lan9 lan10 lan11 lan12 lan13" \
		"lan1"
	;;
*)
	echo "Unsupported hardware. Network interfaces not initialized"
	;;
esac

board_config_flush

exit 0
